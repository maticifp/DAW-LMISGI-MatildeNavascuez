{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Esquema CIFP",
    "type": "object",
    "properties": {
        "cifp": {
            "type": "object",
            "properties": {
                "alumne": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/alumneType"
                    }
                },
                "professor": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/professorType"
                    }
                }
            },
            "additionalProperties": false
        }
    },
    "required": [
        "cifp"
    ],
    "definitions": {
        "alumneType": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "nom": {
                    "type": "string"
                },
                "llinatges": {
                    "type": "string"
                },
                "data_naixement": {
                    "type": "string"
                },
                "correu": {
                    "type": "string"
                },
                "telefon": {
                    "type": "string"
                },
                "adreça": {
                    "type": "string"
                },
                "data_matricula": {
                    "type": "string"
                },
                "curs": {
                    "type": "string",
                    "enum": [
                        "DAM",
                        "DAW",
                        "ASIX",
                        "SMX",
                        "SEIA",
                        "ER",
                        "AUT"
                    ]
                }
            },
            "required": [
                "id",
                "nom",
                "llinatges",
                "data_matricula",
                "curs"
            ]
        },
        "professorType": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "nom": {
                    "type": "string"
                },
                "llinatges": {
                    "type": "string"
                },
                "data_incorporació": {
                    "type": "string"
                },
                "departament": {
                    "type": "string",
                    "enum": [
                        "Informàtica",
                        "Electricitat",
                        "Automoció"
                    ]
                },
                "assignatura": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/assignaturaType"
                    }
                }
            },
            "required": [
                "id",
                "nom",
                "llinatges",
                "data_incorporació",
                "departament"
            ]
        },
        "assignaturaType": {
            "type": "object",
            "properties": {
                "id_assignatura": {
                    "type": "integer"
                },
                "nom_assignatura": {
                    "type": "string"
                },
                "cicle": {
                    "type": "string",
                    "enum": [
                        "DAM",
                        "DAW",
                        "ASIX",
                        "SMX",
                        "SEIA",
                        "ER",
                        "AUT"
                    ]
                },
                "data_inici": {
                    "type": "string"
                },
                "data_final": {
                    "type": "string"
                }
            },
            "required": [
                "id_assignatura",
                "nom_assignatura",
                "cicle"
            ]
        }
    }
}